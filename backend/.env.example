# Trust, Privacy & Digital Provenance - Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-replace-in-production-with-high-entropy-random-bytes
PORT=5000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Paths
STORAGE_DIR=storage
UPLOADS_DIR=storage/uploads
KEYS_DIR=storage/keys
DATABASE_PATH=storage/provenance.db

# Security & Constraints
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False  # Set to True in HTTPS production
